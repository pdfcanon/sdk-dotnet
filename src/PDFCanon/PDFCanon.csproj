<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PDFCanon</AssemblyName>
    <RootNamespace>PDFCanon</RootNamespace>
    <PackageId>PDFCanon</PackageId>
    <Version>1.0.0</Version>
    <Authors>PDFCanon</Authors>
    <Description>Official .NET SDK for the PDFCanon API</Description>
    <PackageTags>pdf;normalize;pdfcanon</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
